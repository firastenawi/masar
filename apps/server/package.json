    "fastify-type-provider-zod": "^7.0.0",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11"
