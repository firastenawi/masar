# انسخ هذا الملف إلى .env وعدّل القيم عند الحاجة

# منفذ الخادم وعنوانه (127.0.0.1 = متاح من جهازك فقط)
API_PORT=3001
API_HOST=127.0.0.1

# مجلد البيانات (قاعدة البيانات والنسخ الاحتياطية). الافتراضي: masar/data
# DATA_DIR=C:/Users/HP/masar-data

# مستوى السجلات: fatal | error | warn | info | debug
LOG_LEVEL=info

# ───── المساعد الذكي ─────
# claude-code: يستخدم اشتراكك عبر Claude Code المثبّت (سجّل الدخول مرة: claude ثم /login)
# fake: ردود تجريبية بلا اتصال
AI_PROVIDER=claude-code
# النموذج: sonnet أو opus أو اتركه فارغاً لافتراضي حسابك
# AI_MODEL=sonnet
# مسار claude.exe إن لم يُكتشف تلقائياً
# CLAUDE_BIN=C:/Users/HP/AppData/Roaming/npm/node_modules/@anthropic-ai/claude-code/bin/claude.exe
AI_DAILY_LIMIT=60

# ───── النسخ الاحتياطي ─────
# مجلد إضافي تُنسخ إليه كل نسخة احتياطية: اختر مجلداً داخل OneDrive أو Google Drive
# ليكون عندك نسخة خارج الجهاز تلقائياً
# BACKUP_COPY_DIR=C:/Users/HP/OneDrive/masar-backups
