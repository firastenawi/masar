{
  "name": "masar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @masar/server\" \"npm run dev -w @masar/web\"",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @masar/server",
    "build": "npm run build -w @masar/web",
    "start": "npm run start -w @masar/server",
    "restore": "npm run restore -w @masar/server --"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
